# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Nairobi
DJANGO_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=1
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Database
DB_NAME=onlinestore
DB_USER=root
DB_PASSWORD=1234
DB_HOST=127.0.0.1
DB_PORT=3306

# Email (production)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=your_user
DJANGO_EMAIL_HOST_PASSWORD=your_password
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=no-reply@example.com

# MPesa
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=YOUR_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET
MPESA_SHORTCODE=YOUR_SHORTCODE
MPESA_PASSKEY=YOUR_PASSKEY
MPESA_CALLBACK_URL=https://yourdomain.com/payments/mpesa/callback/
MPESA_ACCOUNT_REFERENCE=OnlineStore Order
MPESA_TRANSACTION_DESC=Online store purchase
MPESA_STK_TRANSACTION_TYPE=CustomerPayBillOnline
